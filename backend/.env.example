# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=mysql+pymysql://skillsphere_user:password@localhost:3306/skillsphere

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
SECRET_KEY=change-me-too

# --- Institutional email restriction (REQ-1) ---
ALLOWED_EMAIL_DOMAIN=college.edu

# --- Email verification links / frontend ---
FRONTEND_BASE_URL=http://localhost:5173

# --- SMTP (REQ-2, REQ-19 notifications) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Set to "true" during local dev to skip real emails and just log the
# verification link to the console instead.
MAIL_SUPPRESS_SEND=true
